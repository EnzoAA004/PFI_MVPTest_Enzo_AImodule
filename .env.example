PFI_ROOT=/content/drive/MyDrive/PFI_MVP
PFI_MODEL_DIR=/app/models/final
PFI_SAGITTAL_MODEL_PATH=/app/models/final/sagittal_spider_multiclass_final_best.pt
PFI_AXIAL_MODEL_PATH=/app/models/final/axial_t2_alkafri_final_v2_candidate.pt
PFI_MODEL_REGISTRY=config/model_registry_final.json
PFI_DATA_FREEZE_CONFIG=config/data_freeze_config.json
PFI_OUTPUT_DIR=/app/outputs
PORT=8000

# Clasificador subarticular (P10.6). El .pt no esta en Git: se monta desde afuera.
# Sin esta variable el servicio arranca igual y solo ese endpoint responde 503; se deja
# declarada y vacia para que "no configurado" sea una decision y no un olvido.
# Ver models/subarticular/README.md.
PFI_SUBARTICULAR_CHECKPOINT_PATH=

# Clasificador degenerativo multitarea SPIDER (P10.7). El checkpoint congelado tampoco
# se guarda en Git. El runtime valida SHA-256 y falla cerrado si no esta configurado.
# P10.9 ya reproduce el preprocessing de Notebook 66 en el endpoint versionado; la
# localizacion discal derivada de segmentacion sigue separada como gate de E2E real.
PFI_P10_7_CHECKPOINT_PATH=
PFI_P10_7_DEVICE=cpu
