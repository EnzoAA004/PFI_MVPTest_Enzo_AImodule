# AI Module - variables de entorno
#
# Todas tienen default en el codigo: el servicio arranca sin ningun .env. Este archivo
# existe para que no haya que leer settings.py ni input_registry.py para saber que se
# puede configurar. Los valores de abajo son los defaults reales salvo donde se aclare.
#
# Nunca poner secretos reales aca.

# ---------------------------------------------------------------------------------
# Rutas y artefactos
# ---------------------------------------------------------------------------------

# Raiz para resultados, figuras y docs de experimentacion. El default historico apunta a
# Google Drive porque el entrenamiento corrio en Colab; dentro del contenedor conviene /app.
# No afecta la inferencia: los modelos se resuelven por PFI_MODEL_DIR.
PFI_ROOT=/app

# Directorio de los checkpoints finales. En la imagen ya vienen copiados aca.
PFI_MODEL_DIR=/app/models/final
PFI_SAGITTAL_MODEL_PATH=/app/models/final/sagittal_spider_multiclass_final_best.pt
PFI_AXIAL_MODEL_PATH=/app/models/final/axial_t2_alkafri_final_v2_candidate.pt

PFI_MODEL_REGISTRY=config/model_registry_final.json
PFI_DATA_FREEZE_CONFIG=config/data_freeze_config.json

# Previsualizaciones, mascaras y assets publicados de cada corrida.
PFI_OUTPUT_DIR=/app/outputs

# Donde quedan las series subidas, ya de-identificadas. Si no persiste entre reinicios,
# los inputId dejan de resolver y el visor devuelve 404 aunque las previsualizaciones
# sigan estando: montarlo en un volumen.
PFI_UPLOAD_DIR=/app/uploads/inputs

PORT=8000

# ---------------------------------------------------------------------------------
# Checkpoints que viven fuera de Git
# ---------------------------------------------------------------------------------

# Clasificador subarticular (P10.6). El .pt no esta en Git: se monta desde afuera.
# Sin esta variable el servicio arranca igual y solo ese endpoint responde 503; se deja
# declarada y vacia para que "no configurado" sea una decision y no un olvido.
# Ver models/subarticular/README.md.
PFI_SUBARTICULAR_CHECKPOINT_PATH=

# Clasificador degenerativo multitarea SPIDER (P10.7). El checkpoint congelado tampoco
# se guarda en Git. El runtime valida SHA-256 y falla cerrado si no esta configurado.
PFI_P10_7_CHECKPOINT_PATH=
PFI_P10_7_DEVICE=cpu

# ---------------------------------------------------------------------------------
# Dispositivo de inferencia
# ---------------------------------------------------------------------------------

# auto | cpu | cuda. Con auto usa GPU si hay. Las dos anteriores caen a esta si no se
# definen por separado.
PFI_INFERENCE_DEVICE=auto
PFI_SUBARTICULAR_DEVICE=

# ---------------------------------------------------------------------------------
# Limites de ingesta (defaults del codigo, en bytes)
# ---------------------------------------------------------------------------------

# Techo de un archivo suelto subido a /inputs. Default 300 MB.
PFI_MAX_UPLOAD_BYTES=314572800
# Techo del contenido descomprimido de un .zip de estudio completo. Default 512 MB.
# Es la defensa contra un zip bomb: se mide al descomprimir, no el tamano del zip.
PFI_MAX_SERIES_UNCOMPRESSED_BYTES=536870912
# Cantidad maxima de archivos dentro de un estudio. Default 4096.
PFI_MAX_SERIES_FILES=4096
# Cortes por lote al segmentar una serie completa. Default 8. Subirlo usa mas memoria.
PFI_FULL_SERIES_BATCH_SIZE=8

# ---------------------------------------------------------------------------------
# Overrides de geometria y nomenclatura
# ---------------------------------------------------------------------------------

# CUIDADO: afectan resultados. Vacios por default, y conviene dejarlos asi salvo que se
# sepa exactamente por que.
#
# Fuerza la transformacion de orientacion del volumen sagital en vez de inferirla. Un
# valor equivocado invierte lados y niveles.
PFI_SAGITTAL_ORIENTATION_TRANSFORM=
# JSON con el mapeo anatomico de la reconstruccion 3D multiplanar.
PFI_MULTIPLANAR_3D_ANATOMICAL_MAPPING_JSON=

# ---------------------------------------------------------------------------------
# Materializacion de modelos desde almacenamiento externo (opcional)
# ---------------------------------------------------------------------------------

# Solo hacen falta si los checkpoints no viajan en la imagen y hay que descargarlos.
# En el flujo actual la imagen ya los trae, asi que quedan vacios.
PFI_SAGITTAL_MODEL_URI=
PFI_AXIAL_MODEL_URI=
PFI_SAGITTAL_MANIFEST_URI=
PFI_AXIAL_MANIFEST_URI=
PFI_SAGITTAL_RELEASE_URI=
PFI_SAGITTAL_MODEL_SHA256=
PFI_SAGITTAL_RELEASE_CONTENT_SHA256=
PFI_SAGITTAL_RELEASE_MANIFEST_SHA256=
PFI_GCP_PROJECT_ID=
# Token de descarga. NO poner un token real en este archivo: va por el entorno del deploy.
PFI_MODEL_DOWNLOAD_TOKEN=
